{
  "workspace": [
    "packages/data-schemas",
    "packages/data-provider",
    "packages/shared",
    "packages/brain",
    "packages/ui",
    "extensions",
    "packages/runtime",
    "apps/api",
    "apps/web",
    "apps/desktop"
  ],
  "tasks": {
    "dev": "deno run --allow-all --env-file=.env --unstable-kv --unstable-cron --no-check --watch apps/api/src/main.ts",
    "test": "deno test --allow-all --unstable-kv --unstable-cron --no-check",
    "start": "deno run --allow-all --env-file=.env --unstable-kv --unstable-cron --no-check apps/api/src/main.ts",
    "web:dev": "deno task --cwd apps/web dev",
    "web:build": "deno task --cwd apps/web build",
    "web:check": "deno task --cwd apps/web check",
    "lint": "deno run -A npm:oxlint",
    "lint:fix": "deno run -A npm:oxlint --fix",
    "format": "deno run -A npm:@biomejs/biome format --write .",
    "format:check": "deno run -A npm:@biomejs/biome format .",
    "check": "deno run -A npm:@biomejs/biome check --write .",
    "check:ci": "deno run -A npm:@biomejs/biome check . && deno task lint"
  },
  "imports": {
    "@codemirror/state": "npm:@codemirror/state@6.7.1",
    "@codemirror/view": "npm:@codemirror/view@6.43.9",
    "@codemirror/language": "npm:@codemirror/language@6.12.4",
    "@codemirror/commands": "npm:@codemirror/commands@6.11.0",
    "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@6.5.2",
    "@lezer/highlight": "npm:@lezer/highlight@1.2.3",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.84.2",
    "@earendil-works/pi-ai/providers/google": "npm:@earendil-works/pi-ai@0.84.2/providers/google",
    "@earendil-works/pi-agent-core": "npm:@earendil-works/pi-agent-core@0.84.2",
    "@std/assert": "https://esm.sh/jsr/@std/assert@1.0.10",
    "@std/dotenv": "https://esm.sh/jsr/@std/dotenv@0.225.5",
    "@std/fs": "https://esm.sh/jsr/@std/fs@1.0.22",
    "@std/front-matter": "https://esm.sh/jsr/@std/front-matter@1.0.9",
    "@std/front-matter/yaml": "https://esm.sh/jsr/@std/front-matter@1.0.9/yaml",
    "@std/path": "https://esm.sh/jsr/@std/path@1.1.4",
    "@std/testing/time": "https://esm.sh/jsr/@std/testing@1.0.15/time",
    "@std/uuid": "https://esm.sh/jsr/@std/uuid@1.0.9",
    "@std/yaml": "https://esm.sh/jsr/@std/yaml@1.2.0",
    "typebox": "npm:typebox@1.3.7",
    "@biomejs/biome": "npm:@biomejs/biome@^1.9.4",
    "oxlint": "npm:oxlint@^0.11.0",
    "boxen": "npm:boxen@^8.0.1",
    "chalk": "npm:chalk@^5.6.2",
    "winston": "npm:winston@^3.18.3",
    "zod": "npm:zod@^4.1.12",
    "grammy": "npm:grammy@^1.21.1",
    "@grammyjs/auto-retry": "npm:@grammyjs/auto-retry@^2.0.0",
    "@grammyjs/ratelimiter": "npm:@grammyjs/ratelimiter@^1.2.1",
    "@grammyjs/stream": "npm:@grammyjs/stream@^1.0.0",
    "commander": "npm:commander@^12.1.0",
    "@work-boost/data-schemas": "./packages/data-schemas/mod.ts",
    "@work-boost/data-schemas/": "./packages/data-schemas/src/",
    "@work-boost/data-provider": "./packages/data-provider/mod.ts",
    "@work-boost/data-provider/": "./packages/data-provider/src/",
    "@work-boost/shared": "./packages/shared/mod.ts",
    "@work-boost/shared/": "./packages/shared/src/",
    "@work-boost/brain": "./packages/brain/mod.ts",
    "@work-boost/brain/": "./packages/brain/src/",
    "@work-boost/ui": "./packages/ui/mod.ts",
    "@work-boost/extensions": "./extensions/mod.ts",
    "@work-boost/extensions/": "./extensions/",
    "@work-boost/runtime": "./packages/runtime/mod.ts",
    "@work-boost/api": "./apps/api/src/main.ts",
    "@work-boost/api/": "./apps/api/src/"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "lint": {
    "exclude": ["node_modules/", ".deno/"]
  },
  "deploy": {
    "org": "nampq11",
    "app": "work-boost"
  },
  "allowScripts": {
    "allow": [],
    "deny": ["npm:@biomejs/biome@1.9.4", "npm:oxlint@0.11.0"]
  }
}
