{
  "name": "workboost-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Work Boost desktop shell (Tauri 2) - convenience scripts",
  "scripts": {
    "build:api": "deno run --allow-all scripts/build-api-sidecar.ts",
    "dev": "npx @tauri-apps/cli dev",
    "build": "npm run build:api -- --force && npx @tauri-apps/cli build",
    "check": "cd src-tauri && cargo check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}