{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@work-boost/data-provider": ["packages/data-provider/mod.ts"],
      "@work-boost/data-provider/*": ["packages/data-provider/src/*"],
      "@work-boost/data-schemas": ["packages/data-schemas/mod.ts"],
      "@work-boost/data-schemas/*": ["packages/data-schemas/src/*"],
      "@work-boost/shared": ["packages/shared/mod.ts"],
      "@work-boost/shared/*": ["packages/shared/src/*"],
      "@work-boost/brain": ["packages/brain/mod.ts"],
      "@work-boost/brain/*": ["packages/brain/src/*"],
      "@work-boost/extensions": ["extensions/mod.ts"],
      "@work-boost/extensions/*": ["extensions/*"],
      "@work-boost/runtime": ["packages/runtime/mod.ts"],
      "@work-boost/runtime/*": ["packages/runtime/*"],
      "@work-boost/api": ["apps/api/src/main.ts"],
      "@work-boost/api/*": ["apps/api/src/*"]
    },
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "jsx": "react",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["apps/", "cli", "packages", "tests", "deno.d.ts"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
